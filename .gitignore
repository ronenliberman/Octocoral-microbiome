# R session state (machine-specific, never shareable)
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Everything the scripts write: figures, tables, logs. Regenerated by running
# the scripts (see HELPER.md), so never committed.
/output/
/Output/

# knitr render artifacts
*_files/
*_cache/
/maps/*.html
/phylogeny/*.html

# Figures are regenerated, so image files stay out of git everywhere.
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
*.gif
*.pdf

# Machine-local assistant permissions
.claude/settings.local.json

# Word, Excel and PowerPoint lock files created while a document is open
~$*

# OneDrive and Windows cruft
Thumbs.db
desktop.ini
